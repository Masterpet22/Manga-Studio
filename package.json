{
  "name": "manga-studio-prototype",
  "version": "0.7.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:static && npm run build:app && npm run build:3d",
    "build:static": "node scripts/build-static.mjs",
    "build:app": "esbuild src/editor.js --bundle --format=iife --minify --outfile=dist/app.js",
    "build:3d": "esbuild src/poser3d-vrm.js --bundle --format=esm --minify --outfile=dist/poser3d.js",
    "test": "node --test tests/*.test.mjs",
    "model:prepare": "node scripts/strip-vrm-thumbnail.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.185.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
